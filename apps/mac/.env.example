# Enables real Diario admin draft sync. Leave unset to use the local mock remote.
VITE_DIARIO_ADMIN_BASE_URL=http://localhost:3000

# Current Diario admin endpoints use local admin session cookies and same-origin
# CSRF checks. Do not commit real cookies or secrets.
# VITE_DIARIO_ADMIN_SESSION_COOKIE=diario_admin_session=replace-me

# Reserved for a future backend auth path if Diario adds bearer-token auth.
# VITE_DIARIO_ADMIN_BEARER_TOKEN=
